[Unit]
Description=DAGmate Telegram alerts bot (no wallet, no game state, no keys)
Documentation=https://github.com/ItsGoonBoyCrypto/DAGmate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The "no keys" process gets its own user precisely BECAUSE it's the most
# exposed (it talks to Telegram). It can't read service.env (the mnemonic) and
# can't write the site's match DB — so an RCE here is an RCE in a notification
# relay, not a path to the arbiter key or the pot.
User=dagmate-bot
Group=dagmate-bot
WorkingDirectory=/opt/dagmate/bot
EnvironmentFile=/etc/dagmate/bot.env
ExecStart=/opt/dagmate/venv/bin/python dagmate_bot.py
Restart=always
RestartSec=10

# Deliberately NOT ordered after the site backend, and not Requires= either.
# Alerts are best-effort by design: the bot being down must never be able to
# stop a match, and the site being down must never stop /unlink working.

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectProc=invisible
ProcSubset=pid

# Only the bot's OWN link database, in its own subdir. DAGMATE_BOT_DB in
# bot.env points here.
ReadWritePaths=/var/lib/dagmate/bot

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dagmate-bot

[Install]
WantedBy=multi-user.target
