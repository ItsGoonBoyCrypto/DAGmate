# DAGmate — SITE BACKEND environment (dagmate-site.service).
#
# No master seed here — the site never holds a key; it asks the sidecar over
# loopback. Install readable only by the site user:
#     install -o root -g dagmate-site -m 0640 site.env /etc/dagmate/site.env

# ── network ─────────────────────────────────────────────────────────────
# Must match service.env.
DAGMATE_NETWORK_ID=mainnet

# ── wiring ──────────────────────────────────────────────────────────────
# Named in the message a player's wallet asks them to sign, so the popup says
# who is asking. Must be the real public host, or the signature prompt lies.
DAGMATE_AUTH_DOMAIN=dagmate.org

# The sidecar (loopback) and the alerts bot (loopback).
DAGMATE_SERVICE_URL=http://127.0.0.1:8910
DAGMATE_BOT_WEBHOOK_URL=http://127.0.0.1:8901

# Shared secret the site sends to the bot on every internal call. Must be the
# SAME value as in bot.env, and at least 32 chars:
#     openssl rand -hex 32
DAGMATE_WEBHOOK_SECRET=

# The alerts bot's public @handle (without the @), from @BotFather. Only used to
# show players a one-tap "open the bot" link in the OPTIONAL alerts settings —
# the bot is never required to play. Leave blank to hide the link entirely.
DAGMATE_BOT_USERNAME=

# Public origin, used to build linkified alert URLs (https://<host>/play/<id>).
DAGMATE_PUBLIC_URL=https://dagmate.org

# The match database — in the site user's OWN directory (see the unit's
# ReadWritePaths). The bot cannot write here.
DAGMATE_SITE_DB=/var/lib/dagmate/site/dagmate_site.db

# ── policy ──────────────────────────────────────────────────────────────
# The platform takes no cut. 0 is the promise on the site, and every fee line
# in the UI derives from this value via /api/meta — so if it is ever raised,
# the UI says so instead of quietly shaving the payout.
DAGMATE_RAKE_BPS=0

# Move anchoring: OFF by default. When "1", every ply is written to L1 as a
# dust tx paid from the operating address — a real per-move cost. Decide the
# economics before turning it on (see config.py). While it's off, the UI does
# not claim moves are anchored.
# DAGMATE_ANCHOR_MOVES=0

# ⚠️ Do NOT set DAGMATE_DEV_ROUTES here. It gates the demo wallet and
# `dev-mark-funded`, which starts a match nobody paid for. Ignored on mainnet
# regardless, but a testnet host that inherits this file should not quietly
# have a free-money button either. Switch it on per-shell when you need it.
