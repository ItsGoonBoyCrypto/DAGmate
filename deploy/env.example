# DAGmate — environment template.
#
# Copy to /etc/dagmate/dagmate.env on the server, fill in the two secrets, then:
#     chown root:root /etc/dagmate/dagmate.env && chmod 600 /etc/dagmate/dagmate.env
#
# All three units read this one file. It is 600 root-only because the first
# line in it can co-sign every settlement on the platform.
#
# systemd EnvironmentFile parses `KEY=value` literally: no shell expansion, no
# quote stripping you can rely on. Write values bare, with no surrounding
# quotes and no trailing spaces.

# ── secrets ─────────────────────────────────────────────────────────────
# Generate ON THE SERVER: cd /opt/dagmate/service && node tools/genseed.mjs
# Never paste in one generated elsewhere. Never reuse another project's.
DAGMATE_MASTER_MNEMONIC=

# Shared secret between the site backend and the alerts bot. Any random string:
#     openssl rand -hex 32
# Both processes must see the same value; they're in the same file, so they do.
DAGMATE_WEBHOOK_SECRET=

# Telegram bot token from @BotFather. The bot holds no keys and no game state,
# but this token can impersonate the bot, so it belongs in this file and not in
# a unit file or a shell history.
DAGMATE_BOT_TOKEN=

# ── network ─────────────────────────────────────────────────────────────
# mainnet, or a testnet id like testnet-10. This is the single switch that
# decides which chain everything derives addresses for and reads UTXOs from.
DAGMATE_NETWORK_ID=mainnet

# Optional. Unset, the SDK's community resolver picks a public node for this
# network and health-checks it (synced + utxoindex + right network) on every
# connection. Set it only to pin a specific node you trust:
#   DAGMATE_KASPA_WRPC=wss://your-node/kaspa/mainnet/wrpc/borsh
# DAGMATE_KASPA_WRPC=

# ── wiring ──────────────────────────────────────────────────────────────
# Named in the message a player's wallet asks them to sign, so the popup says
# who is asking. Must be the real public host, or the signature prompt lies.
DAGMATE_AUTH_DOMAIN=dagmate.org

DAGMATE_SERVICE_URL=http://127.0.0.1:8910
DAGMATE_BOT_WEBHOOK_URL=http://127.0.0.1:8901

DAGMATE_SITE_DB=/var/lib/dagmate/dagmate_site.db
DAGMATE_BOT_DB=/var/lib/dagmate/dagmate_bot.db

# ── policy ──────────────────────────────────────────────────────────────
# The platform takes no cut. 0 is the promise on the site, and every fee line
# in the UI derives from this value via /api/meta — so if it is ever raised,
# the UI says so instead of quietly shaving the payout.
DAGMATE_RAKE_BPS=0

# ⚠️ Do NOT set DAGMATE_DEV_ROUTES here. It gates the demo wallet and
# `dev-mark-funded`, which starts a match nobody paid for. It is ignored on
# mainnet regardless, but a testnet host that inherits this file should not
# quietly have a free-money button either. Switch it on per-shell when you
# actually need it.
