# DAGmate — ALERTS BOT environment (dagmate-bot.service).
#
# No seed, no game state — a Telegram notification relay. Install readable only
# by the bot user:
#     install -o root -g dagmate-bot -m 0640 bot.env /etc/dagmate/bot.env

# Telegram bot token from @BotFather. Holds no keys, but can impersonate the
# bot, so it belongs here and not in a unit file or a shell history.
DAGMATE_BOT_TOKEN=

# Shared secret the site backend must present on every internal call. Must be
# the SAME value as in site.env, and at least 32 chars:
#     openssl rand -hex 32
DAGMATE_WEBHOOK_SECRET=

# Loopback listener for the site's calls. Widen the host only if the site runs
# on a different box, behind its own network controls.
# DAGMATE_WEBHOOK_HOST=127.0.0.1
# DAGMATE_WEBHOOK_PORT=8901

# The bot's OWN link database, in its own directory (see the unit's
# ReadWritePaths). It never touches the site's match DB.
DAGMATE_BOT_DB=/var/lib/dagmate/bot/dagmate_bot.db

# One-time link-code lifetime, seconds.
DAGMATE_LINK_CODE_TTL_S=600
